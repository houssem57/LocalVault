<Window x:Class="LocalVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalVault.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="LocalVault" Icon="/Assets/app.ico"
        Width="1100" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- ═══════════════ Lock / setup screen ═══════════════ -->
        <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource InvBoolToVis}}">
            <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <Image Source="/Assets/app.ico" Width="56" Height="56" Margin="0,0,0,12" />
                    <TextBlock Text="LocalVault" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />

                    <!-- Unlock -->
                    <StackPanel Visibility="{Binding IsInitialized, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Enter your master password to unlock." Margin="0,6,0,20" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Master password" Style="{StaticResource SectionLabel}" />
                        <PasswordBox x:Name="UnlockPassword" KeyDown="UnlockPassword_KeyDown" />
                        <Button Content="Unlock" Style="{DynamicResource AccentButtonStyle}" Margin="0,16,0,0"
                                HorizontalAlignment="Stretch" Height="36" Click="Unlock_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                    </StackPanel>

                    <!-- First run -->
                    <StackPanel Visibility="{Binding IsInitialized, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Create a master password. It encrypts everything in your vault and cannot be recovered if you forget it." />
                        <TextBlock Text="Master password" Style="{StaticResource SectionLabel}" />
                        <PasswordBox x:Name="CreatePassword" PasswordChanged="CreatePassword_PasswordChanged" />
                        <ProgressBar x:Name="StrengthBar" Height="4" Margin="0,6,0,0" Maximum="100" />
                        <TextBlock x:Name="StrengthText" FontSize="12" Margin="0,2,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Confirm master password" Style="{StaticResource SectionLabel}" />
                        <PasswordBox x:Name="ConfirmPassword" KeyDown="ConfirmPassword_KeyDown" />
                        <Button Content="Create vault" Style="{DynamicResource AccentButtonStyle}" Margin="0,16,0,0"
                                HorizontalAlignment="Stretch" Height="36" Click="Create_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Height="4"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding LockError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"
                               Visibility="{Binding LockError, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════ Vault ═══════════════ -->
        <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,16">
                            <Image Source="/Assets/app.ico" Width="24" Height="24" />
                            <TextBlock Text="LocalVault" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,0"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Search vault (Ctrl+F)" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding SearchText, Converter={StaticResource InvNullToVis}}" />
                        </Grid>

                        <ListBox x:Name="FilterList" Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="FilterList_SelectionChanged">
                            <ListBoxItem Tag="{x:Static vm:VaultFilter.All}" IsSelected="True">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountAll}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="All items" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static vm:VaultFilter.Favorites}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountFavorites}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Favorites" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem IsEnabled="False" Padding="8,14,8,4">
                                <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static vm:VaultFilter.Websites}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountWebsites}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Websites" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static vm:VaultFilter.DesktopApps}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountApps}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Desktop apps" />
                                </DockPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Command="{Binding OpenGeneratorCommand}" AutomationProperties.Name="Password generator">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" Margin="0,0,10,0" />
                                <TextBlock Text="Password generator" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,10,0" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding LockCommand}" ToolTip="Lock (Ctrl+L)" AutomationProperties.Name="Lock vault">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Margin="0,0,10,0" />
                                <TextBlock Text="Lock vault" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Item list -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="16,16,16,8">
                    <TextBlock Text="Items" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddCommand}" ToolTip="New item (Ctrl+N)" AutomationProperties.Name="New item">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="New item" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid>
                    <ListBox x:Name="EntryList" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}"
                             Margin="8,0,8,8" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="EntryList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,4">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE735;" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No items yet.&#x0a;Log in to an app or site and LocalVault will offer to save it — or click New item."
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding CountAll, Converter={StaticResource ZeroToVis}}" />
                </Grid>
            </DockPanel>

            <!-- Details -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <TextBlock Text="Select an item to see its details" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="28,24" DataContext="{Binding SelectedEntry}">
                            <DockPanel Margin="0,0,0,20">
                                <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" ToolTip="Favorite" AutomationProperties.Name="Favorite"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding IsFavorite, Converter={StaticResource FavoriteGlyph}}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Edit (Ctrl+E)" AutomationProperties.Name="Edit (Ctrl+E)"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="{Binding Category, Converter={StaticResource CategoryToGlyph}}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryToText}}" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <!-- Username -->
                                    <TextBlock Text="Username" Style="{StaticResource SectionLabel}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Copy username" AutomationProperties.Name="Copy username"
                                                Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" />
                                        </Button>
                                        <TextBox Text="{Binding Username, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="15" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Separator Margin="0,12" />

                                    <!-- Password -->
                                    <TextBlock Text="Password" Style="{StaticResource SectionLabel}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Copy password (clears in 30 s)" AutomationProperties.Name="Copy password (clears in 30 s)"
                                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" />
                                        </Button>
                                        <ToggleButton DockPanel.Dock="Right" Width="36" Height="32" Padding="0" Margin="4,0,0,0" ToolTip="Reveal password" AutomationProperties.Name="Reveal password"
                                                      IsChecked="{Binding DataContext.IsPasswordRevealed, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" />
                                        </ToggleButton>
                                        <TextBox Text="{Binding DataContext.DisplayPassword, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="15"
                                                 FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Website / app -->
                                    <StackPanel Visibility="{Binding Url, Converter={StaticResource NullToVis}}">
                                        <Separator Margin="0,12" />
                                        <TextBlock Text="Website" Style="{StaticResource SectionLabel}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Open website" AutomationProperties.Name="Open website"
                                                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" />
                                            </Button>
                                            <TextBox Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding AppPath, Converter={StaticResource NullToVis}}">
                                        <Separator Margin="0,12" />
                                        <TextBlock Text="Application" Style="{StaticResource SectionLabel}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Launch app" AutomationProperties.Name="Launch app"
                                                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" />
                                            </Button>
                                            <TextBox Text="{Binding AppPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Notes, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Notes" Style="{StaticResource SectionLabel}" />
                                    <TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="2,14,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="Modified " /><Run Text="{Binding Modified, StringFormat='{}{0:g}', Mode=OneWay}" />
                                <Run Text="   ·   Created " /><Run Text="{Binding Created, StringFormat='{}{0:g}', Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status snackbar -->
            <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                    Padding="16,10" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
