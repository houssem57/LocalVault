<Window x:Class="LocalVault.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Text="New item" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Title" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="TitleBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Category" Style="{StaticResource SectionLabel}" />
                <ComboBox x:Name="CategoryBox" SelectedIndex="0" SelectionChanged="CategoryBox_SelectionChanged">
                    <ComboBoxItem Content="Website" />
                    <ComboBoxItem Content="Desktop app" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="Username or email" Style="{StaticResource SectionLabel}" />
        <TextBox x:Name="UsernameBox" Margin="0,0,0,12" />

        <TextBlock Text="Password" Style="{StaticResource SectionLabel}" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Generate password" AutomationProperties.Name="Generate password" Click="Generate_Click">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" />
            </Button>
            <ToggleButton x:Name="RevealToggle" DockPanel.Dock="Right" Width="36" Height="32" Padding="0" Margin="4,0,0,0"
                          ToolTip="Show password" AutomationProperties.Name="Show password" Checked="RevealToggle_Changed" Unchecked="RevealToggle_Changed">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" />
            </ToggleButton>
            <Grid>
                <PasswordBox x:Name="PasswordBox" />
                <TextBox x:Name="PasswordText" Visibility="Collapsed" FontFamily="{StaticResource MonoFont}" />
            </Grid>
        </DockPanel>

        <StackPanel x:Name="UrlPanel">
            <TextBlock Text="Website URL" Style="{StaticResource SectionLabel}" />
            <TextBox x:Name="UrlBox" Margin="0,0,0,12" />
        </StackPanel>

        <StackPanel x:Name="AppPanel" Visibility="Collapsed">
            <TextBlock Text="Application path" Style="{StaticResource SectionLabel}" />
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                <TextBox x:Name="AppPathBox" />
            </DockPanel>
        </StackPanel>

        <TextBlock Text="Notes" Style="{StaticResource SectionLabel}" />
        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

        <CheckBox x:Name="FavoriteBox" Content="Favorite" Margin="0,0,0,8" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
