<Window x:Class="LocalVault.Views.SaveCredentialToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save password — LocalVault" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Margin="16" CornerRadius="10" Padding="18"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Width="28" Height="28" Padding="0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="Ignore_Click"
                        Background="Transparent" BorderThickness="0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                </Button>
                <Image Source="/Assets/app.ico" Width="22" Height="22" Margin="0,0,10,0" />
                <TextBlock x:Name="HeadingText" Text="Save password?" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Locked: unlock inline -->
            <StackPanel x:Name="UnlockPanel" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="LocalVault is locked. Enter your master password to save." TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                <PasswordBox x:Name="MasterBox" KeyDown="MasterBox_KeyDown" />
                <TextBlock x:Name="UnlockError" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                           Margin="0,4,0,0" Text="Incorrect master password." />
            </StackPanel>

            <TextBlock Text="Title" Style="{StaticResource SectionLabel}" />
            <TextBox x:Name="TitleBox" Margin="0,0,0,8" />
            <TextBlock Text="Username" Style="{StaticResource SectionLabel}" />
            <TextBox x:Name="UsernameBox" Margin="0,0,0,8" />
            <TextBlock Text="Password" Style="{StaticResource SectionLabel}" />
            <DockPanel>
                <ToggleButton x:Name="RevealToggle" DockPanel.Dock="Right" Width="36" Height="32" Padding="0" Margin="6,0,0,0"
                              ToolTip="Show password" AutomationProperties.Name="Show password" Checked="RevealToggle_Changed" Unchecked="RevealToggle_Changed">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" />
                </ToggleButton>
                <Grid>
                    <PasswordBox x:Name="PasswordBox" />
                    <TextBox x:Name="PasswordText" Visibility="Collapsed" FontFamily="{StaticResource MonoFont}" />
                </Grid>
            </DockPanel>

            <TextBlock x:Name="SourceText" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <Grid Margin="0,14,0,0">
                <Button Content="Never for this site" HorizontalAlignment="Left" Click="Never_Click" x:Name="NeverButton"
                        Background="Transparent" BorderThickness="0" Padding="4,6"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="Save" Style="{DynamicResource AccentButtonStyle}" MinWidth="84" Click="Save_Click" />
                    <Button Content="Ignore" MinWidth="84" Margin="8,0,0,0" Click="Ignore_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
