<Window x:Class="LocalVault.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password generator" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock Text="Password generator" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Copy" AutomationProperties.Name="Copy" Click="Copy_Click">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Regenerate" AutomationProperties.Name="Regenerate" Click="Regenerate_Click">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                </Button>
                <TextBox x:Name="Output" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="16"
                         FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="EntropyText" FontSize="12" Margin="2,6,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=LengthSlider, StringFormat={}{0:0}}" FontWeight="SemiBold" />
            <TextBlock Text="Length" />
        </DockPanel>
        <Slider x:Name="LengthSlider" Minimum="12" Maximum="64" Value="20" IsSnapToTickEnabled="True" TickFrequency="1"
                ValueChanged="Option_Changed" Margin="0,0,0,12" />

        <UniformGrid Columns="2">
            <CheckBox x:Name="UpperBox" Content="Uppercase (A–Z)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,8" />
            <CheckBox x:Name="LowerBox" Content="Lowercase (a–z)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,8" />
            <CheckBox x:Name="DigitBox" Content="Numbers (0–9)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
            <CheckBox x:Name="SymbolBox" Content="Symbols (!@#…)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
        </UniformGrid>

        <TextBlock x:Name="CopiedText" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                   Text="Copied — the clipboard clears automatically." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="UseButton" Content="Use password" Style="{DynamicResource AccentButtonStyle}" MinWidth="110"
                    IsDefault="True" Click="Use_Click" Visibility="Collapsed" />
            <Button x:Name="CloseButton" Content="Close" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
