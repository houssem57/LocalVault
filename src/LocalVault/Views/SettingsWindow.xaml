<Window x:Class="LocalVault.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Security" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DockPanel Margin="0,0,0,10">
                    <ComboBox x:Name="AutoLockBox" DockPanel.Dock="Right" Width="150" />
                    <TextBlock Text="Lock automatically after inactivity" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel>
                    <ComboBox x:Name="ClipboardBox" DockPanel.Dock="Right" Width="150" />
                    <TextBlock Text="Clear copied passwords after" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Behavior" FontWeight="SemiBold" Margin="0,0,0,10" />
                <CheckBox x:Name="StartupBox" Content="Start with Windows (minimized to the tray)" Margin="0,0,0,8" />
                <CheckBox x:Name="DetectBox" Content="Offer to save passwords I type into apps and websites" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Auto-fill" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0" Click="ResetHotkey_Click" />
                    <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             TextAlignment="Center" PreviewKeyDown="HotkeyBox_PreviewKeyDown" AutomationProperties.Name="Auto-fill hotkey"
                             ToolTip="Click, then press the new key combination" />
                    <TextBlock Text="Fill hotkey" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="HotkeyStatus" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Click the box and press a new combination (needs Ctrl, Alt or Win)." />
                <CheckBox x:Name="AutoSubmitBox" Content="Press Enter after filling (auto-submit)" Margin="0,0,0,8" />
                <CheckBox x:Name="AlwaysPasteBox" Content="Fill by pasting instead of typing (for apps that ignore typed input)" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Never save for" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ListBox x:Name="NeverList" Height="100" BorderThickness="0" />
                <Button Content="Remove selected" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RemoveNever_Click" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Vault file" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="PathText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Content="Open folder" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenFolder_Click" />
                <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Encrypted with AES-256-GCM using a key derived from your master password (PBKDF2-SHA512, 600,000 iterations). LocalVault never connects to the network." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
