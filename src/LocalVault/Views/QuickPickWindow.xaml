<Window x:Class="LocalVault.Views.QuickPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalVault Quick Fill" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Margin="20" CornerRadius="14"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.4" />
        </Border.Effect>
        <StackPanel>
            <!-- Search -->
            <Grid Margin="16,14,16,8">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="18" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="SearchBox" Margin="30,0,0,0" FontSize="18" BorderThickness="0" Background="Transparent"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         AutomationProperties.Name="Search vault" />
                <TextBlock x:Name="Placeholder" Text="Search your vault…" FontSize="18" Margin="33,0,0,0" IsHitTestVisible="False"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TextBlock x:Name="TargetText" Margin="18,0,16,8" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Results -->
            <ListBox x:Name="Results" MaxHeight="340" Margin="8" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="Results_PreviewMouseLeftButtonUp" KeyDown="Results_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,5">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Entry.Initial}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Match" FontSize="11" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Entry.Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="No items found" Margin="0,8,0,20" HorizontalAlignment="Center" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <TextBlock Margin="18,8,16,10" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="↑ ↓ to choose  ·  Enter to fill  ·  Esc to cancel" />
        </StackPanel>
    </Border>
</Window>
