<Window x:Class="LocalVault.Views.UnlockBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock LocalVault" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Margin="16" CornerRadius="12" Padding="16"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Image Source="/Assets/app.ico" Width="22" Height="22" Margin="0,0,10,0" />
                <TextBlock x:Name="HeadingText" Text="Unlock LocalVault to fill" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Grid>
                <PasswordBox x:Name="MasterBox" KeyDown="MasterBox_KeyDown" AutomationProperties.Name="Master password" />
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,6,0,0"
                       Visibility="Collapsed" Text="Incorrect master password." />
            <TextBlock Text="Enter to unlock · Esc to cancel" FontSize="11" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
</Window>
